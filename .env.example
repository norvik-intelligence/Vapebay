# Kopieren nach .env und ausfüllen. .env ist in .gitignore.

# Auf Vercel wird nichts davon gebraucht, damit der Shop läuft — nur die
# beiden Admin-Werte weiter unten, falls /admin nutzbar sein soll.

# ── Anwendung ──────────────────────────────────────────────────────────────
# Absolute Basis-URL. Wird für Canonicals, JSON-LD und die Sitemap verwendet —
# ohne korrekten Wert zeigen alle strukturierten Daten auf localhost.
NEXT_PUBLIC_SITE_URL=https://vapebay.de

# SQLite-Datei im Container. Liegt auf dem Volume `vapebay-data`.
# Ohne Wert: lokal ./data/vapebay.db, auf Vercel /tmp/vapebay.db (flüchtig).
# Die Datei wird beim ersten Zugriff automatisch angelegt und befüllt.
DATABASE_URL=/app/data/vapebay.db

# ── Caddy / TLS ────────────────────────────────────────────────────────────
SITE_DOMAIN=vapebay.de
SITE_URL=https://vapebay.de
ACME_EMAIL=admin@vapebay.de

# ── Admin-Zugang ───────────────────────────────────────────────────────────
# Zwei unabhängige Schichten. Beide setzen, nicht nur eine:
#
# 1) Anwendungs-Session (src/middleware.ts). Ohne diese beiden Werte bleibt
#    /admin gesperrt — das ist beabsichtigt, kein Fehler.
#
#    Session-Secret erzeugen (mind. 16 Zeichen):
#      openssl rand -hex 32
#
#    Passwort-Hash erzeugen (SHA-256, hex — NICHT das Klartextpasswort):
#      node -e "crypto.subtle.digest('SHA-256',new TextEncoder().encode('deinPasswort')).then(h=>console.log(Buffer.from(h).toString('hex')))"
ADMIN_SESSION_SECRET=
ADMIN_PASSWORD=

# 2) Basic-Auth im Reverse Proxy. Schützt davor, dass Next.js überhaupt
#    erreicht wird. Hash erzeugen:
#      docker run --rm caddy:2-alpine caddy hash-password --plaintext 'deinPasswort'
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# ── Externe Dienste (Platzhalter) ──────────────────────────────────────────
# Die Ident- und Lieferanten-Integrationen sind aktuell simuliert. Sobald die
# echten Clients eingesetzt werden, kommen die Zugangsdaten hier hinein und
# NICHT in den Code.
POSTIDENT_API_KEY=
SOFORT_IDENT_API_KEY=
SUPPLIER_EUROVAPE_TOKEN=
SUPPLIER_NORDLIQUID_SSH_KEY_PATH=
